# ZeroTouch — Environment Variables
# Copy this file to .env and fill in your API key

# Gemini API key for Layer 3 AI Resolution Agent
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Grok workflow bot key (used by the "Run workflow bot" action)
# Create one at https://console.x.ai/ under API Keys
XAI_API_KEY=your_xai_api_key_here

# ZeroTouch — Environment Variables
# Copy this file to .env and fill in your API key

# Gemini API key for Layer 3 AI Resolution Agent
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Grok model for the employee AI teammate (key stays on the backend)
XAI_API_KEY=
XAI_MODEL=grok-4.7
# Optional endpoint override for compatible test environments
# XAI_BASE_URL=https://api.x.ai/v1
